---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArticleList from '@components/ArticleList.astro';
import { language } from '../i18n/utils';
import { portfolioCopy } from '../i18n/portfolio';
const c = portfolioCopy(language(Astro.url));
---
<BaseLayout title={c('writing')} description={c('writingDescription')}>
  <section class="section"><div class="container-page"><div class="page-intro"><p class="eyebrow">{c('writing')}</p><h1 class="page-title">{c('writingTitle')}</h1><p class="lead">{c('writingDescription')}</p></div><ArticleList heading="h2" /></div></section>
</BaseLayout>
