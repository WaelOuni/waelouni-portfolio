---
import { language, translator } from '../i18n/utils';
import { portfolioCopy } from '../i18n/portfolio';
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import StockPilot from '@components/StockPilot.astro';
import ContactBanner from '@components/ContactBanner.astro';
import { projects } from '@data/projects';
const lang = language(Astro.url);
const c = portfolioCopy(lang);
const t = translator(lang);
---
<BaseLayout title={t('Projets')} description={c('projectsDescription')}>
  <section class="section"><div class="container-page">
    <div class="page-intro"><p class="eyebrow">{t('Projets')}</p><h1 class="page-title">{c('projectsTitle')}</h1><p class="lead">{c('projectsDescription')}</p></div>
    <StockPilot full />
    <div class="mt-16 mb-8"><h2 class="section-title">{c('clientWork')}</h2><p class="mt-5 max-w-2xl text-slate-600">{c('clientNote')}</p></div>
    {projects.map(project => <ProjectCard project={project} />)}
  </div></section>
  <ContactBanner />
</BaseLayout>
