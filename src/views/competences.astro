---
import { language, translator, localizeData } from '../i18n/utils';
import { portfolioCopy } from '../i18n/portfolio';
import BaseLayout from '@layouts/BaseLayout.astro';
import SkillCard from '@components/SkillCard.astro';
import ContactBanner from '@components/ContactBanner.astro';
import { skillCategories } from '@data/skills';
const lang = language(Astro.url);
const c = portfolioCopy(lang);
const t = translator(lang);
const evidence = ['adeo-supply-chain', 'adeo-supply-chain', 'axa-integration', 'adeo-supply-chain', 'adeo-payments', 'adeo-supply-chain', 'ag2r-modernization', 'enki-portal', 'ag2r-modernization'];
---
<BaseLayout title={`${t('Compétences')} — Java, Kafka & Cloud`} description={c('skillsDescription')}>
  <section class="section"><div class="container-page"><div class="page-intro"><p class="eyebrow">{t('Compétences')}</p><h1 class="page-title">{c('skillsTitle')}</h1><p class="lead">{c('skillsDescription')}</p></div><div class="grid gap-x-16 md:grid-cols-2">{localizeData(skillCategories, lang).map((skill, i) => <SkillCard skill={skill} evidence={evidence[i]} />)}</div></div></section>
  <ContactBanner />
</BaseLayout>
