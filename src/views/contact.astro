---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactCard from '@components/ContactCard.astro';
import ResumeDownloads from '@components/ResumeDownloads.astro';
import { language } from '../i18n/utils';
import { portfolioCopy } from '../i18n/portfolio';
const c = portfolioCopy(language(Astro.url));
---
<BaseLayout title={c('contactLabel')} description={c('contactDescription')}>
  <section class="section">
    <div class="container-page grid items-start gap-12 lg:grid-cols-[1.3fr_1fr]">
      <div><p class="eyebrow">{c('contactLabel')}</p><h1 class="page-title mt-5">{c('contactTitle')}</h1><p class="lead mt-6">{c('contactDescription')}</p><p class="mt-6 max-w-xl text-slate-600">{c('contactPrompt')}</p><div class="mt-8"><ResumeDownloads compact /></div></div>
      <ContactCard />
    </div>
  </section>
</BaseLayout>
