---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import StockPilot from '@components/StockPilot.astro';
import ContactBanner from '@components/ContactBanner.astro';
import ArticleList from '@components/ArticleList.astro';
import { language, localizeData } from '../i18n/utils';
import { portfolioCopy } from '../i18n/portfolio';
import { routes } from '../i18n/routes';
import { experiences } from '../data/experiences';
const lang = language(Astro.url);
const c = portfolioCopy(lang);
const selected = localizeData(experiences, lang).slice(0, 2);
---
<BaseLayout title={`${c('role')} | Spring Boot, Kafka & Cloud`} description={c('homeDescription')}>
  <Hero />
  <section class="section">
    <div class="container-page">
      <div class="section-heading"><div><p class="eyebrow mb-4">{c('core')}</p><h2 class="section-title">{c('coreTitle')}</h2></div><a class="text-link" href={routes.skills[lang]}>{lang === 'en' ? 'Explore my skills' : 'Découvrir mes compétences'} <span aria-hidden="true">↗</span></a></div>
      <div class="expertise-grid">
        {([
          ['backend', 'backendBody', 'Java · Spring Boot · REST'],
          ['events', 'eventsBody', 'Apache Kafka · MongoDB · Oracle'],
          ['operations', 'operationsBody', 'Kubernetes · CI/CD · Datadog'],
        ] as const).map(([title, body, stack], i) => <div class="border-t border-line pt-5"><span class="text-sm text-slate-500" aria-hidden="true">0{i + 1}</span><h3>{c(title)}</h3><p>{c(body)}</p><p class="mt-4 text-sm font-medium">{stack}</p></div>)}
      </div>
    </div>
  </section>
  <section class="section section-white">
    <div class="container-page">
      <div class="section-heading"><div><p class="eyebrow mb-4">{c('selected')}</p><h2 class="section-title">{c('experienceTitle')}</h2></div><a class="text-link" href={routes.experience[lang]}>{c('allExperience')} <span aria-hidden="true">↗</span></a></div>
      {selected.map((item, i) => <article class="experience-preview">
        <div><h3 class="text-xl font-semibold">{item.client}</h3><p class="mt-2 text-sm text-slate-600">{item.period}</p></div>
        <div><p class="font-semibold">{item.role}</p><p class="mt-3 text-slate-600">{c(i === 0 ? 'adeoSummary' : 'ag2rSummary')}</p></div>
        <a class="text-link text-sm" href={`${routes.experience[lang]}#${item.id}`}>{c('evidence')}<span class="sr-only"> — {item.client}</span></a>
      </article>)}
    </div>
  </section>
  <section class="section">
    <div class="container-page">
      <div class="section-heading"><div><p class="eyebrow mb-4">{lang === 'en' ? 'Featured project' : 'Projet à découvrir'}</p><h2 class="section-title">{lang === 'en' ? 'From backend systems to product thinking.' : 'Du backend à l’ingénierie produit.'}</h2></div><a class="text-link" href={routes.projects[lang]}>{c('allProjects')} <span aria-hidden="true">↗</span></a></div>
      <StockPilot />
    </div>
  </section>
  <section class="section section-white">
    <div class="container-page">
      <p class="eyebrow mb-4">{c('approach')}</p><h2 class="section-title mb-10">{c('approachTitle')}</h2>
      <div class="expertise-grid">{(['1', '2', '3'] as const).map(n => <div><span class="eyebrow" aria-hidden="true">0{n}</span><h3>{c(`approach${n}`)}</h3><p>{c(`approachBody${n}`)}</p></div>)}</div>
    </div>
  </section>
  <section class="section">
    <div class="container-page"><p class="eyebrow mb-4">{c('writing')}</p><h2 class="section-title mb-10">{c('writingTitle')}</h2><ArticleList /></div>
  </section>
  <ContactBanner />
</BaseLayout>
