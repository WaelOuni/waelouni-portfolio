---
import { language, translator, localizeData } from '../i18n/utils';
import { portfolioCopy } from '../i18n/portfolio';
import BaseLayout from '@layouts/BaseLayout.astro';
import ExperienceCard from '@components/ExperienceCard.astro';
import ContactBanner from '@components/ContactBanner.astro';
import { experiences } from '@data/experiences';
const lang = language(Astro.url);
const c = portfolioCopy(lang);
const t = translator(lang);
---
<BaseLayout title={`${t('Parcours')} — ${c('role')}`} description={c('experienceDescription')}>
  <section class="section"><div class="container-page">
    <div class="page-intro"><p class="eyebrow">{t('Parcours')}</p><h1 class="page-title">{c('experienceTitle')}</h1><p class="lead">{c('experienceDescription')}</p></div>
    {localizeData(experiences, lang).map(experience => <ExperienceCard experience={experience} />)}
  </div></section>
  <ContactBanner />
</BaseLayout>
