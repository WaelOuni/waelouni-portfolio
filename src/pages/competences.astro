---
import BaseLayout from "@layouts/BaseLayout.astro";
import SkillCard from "@components/SkillCard.astro";
import { skillCategories } from "@data/skills";
---

<BaseLayout
  title="Compétences Java, Spring Boot, Kafka et Fullstack"
  description="Compétences de Wael Ouni : Java, Spring Boot, Kafka, Kafka Connect, GCP, Kubernetes, Docker, Angular, Vue.js, Datadog, MongoDB, Oracle, CI/CD et sécurité."
>
  <section class="section">
    <div class="container-page">
      <div class="mb-12 max-w-3xl">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-brand-600">Compétences</p>
        <h1 class="text-4xl font-bold text-ink md:text-5xl">Expertise fullstack, cloud et observabilité</h1>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          Une expertise structurée pour concevoir des microservices Java, traiter des flux Kafka,
          développer des interfaces Angular/Vue.js, industrialiser les déploiements et piloter l'observabilité.
        </p>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {skillCategories.map((skill) => <SkillCard skill={skill} />)}
      </div>
    </div>
  </section>
</BaseLayout>
