---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import SectionTitle from "@components/SectionTitle.astro";
import SkillCard from "@components/SkillCard.astro";
import ExperienceCard from "@components/ExperienceCard.astro";
import ProjectCard from "@components/ProjectCard.astro";
import ContactCard from "@components/ContactCard.astro";
import { skillCategories } from "@data/skills";
import { experiences } from "@data/experiences";
import { projects } from "@data/projects";

const blogPosts = [
  {
    title: "Kafka avec Spring Boot en production : bonnes pratiques",
    href: "/blog/kafka-spring-boot-production/",
    description: "Consumer groups, idempotence, retries, DLQ, observabilité et monitoring du lag."
  },
  {
    title: "Monitoring Datadog pour microservices Kubernetes",
    href: "/blog/monitoring-datadog-kubernetes/",
    description: "Logs, metrics, traces, pods, restarts, dashboards et alerting exploitable."
  },
  {
    title: "Architecture event-driven avec Java, Spring Boot et Kafka",
    href: "/blog/architecture-event-driven-java-kafka/",
    description: "Avantages, risques, patterns, résilience et observabilité des architectures événementielles."
  }
];
---

<BaseLayout
  title="Wael Ouni - Développeur Fullstack Java Senior"
  description="Portfolio de Wael Ouni, développeur fullstack Java senior spécialisé en Java, Spring Boot, Kafka, microservices, GCP, Kubernetes, Angular, CI/CD et observabilité."
>
  <Hero />

  <section class="section">
    <div class="container-page">
      <SectionTitle
        eyebrow="Compétences clés"
        title="Un socle fullstack orienté systèmes distribués"
        description="Java, Spring Boot, Kafka, GCP, Kubernetes, Angular et Datadog pour construire, exploiter et faire évoluer des plateformes critiques."
      />
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {skillCategories.slice(0, 4).map((skill) => <SkillCard skill={skill} />)}
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <SectionTitle
        eyebrow="Expériences"
        title="Des missions au contact de la production"
        description="Supply Chain, assurance, e-commerce, paiement, dashboards, intégration Kafka, CI/CD et support production."
      />
      <div class="grid gap-6">
        {experiences.map((experience) => <ExperienceCard experience={experience} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <SectionTitle
        eyebrow="Projets"
        title="Réalisations techniques représentatives"
        description="Des projets centrés sur les flux Kafka, les batchs critiques, les API métier, les migrations cloud et les interfaces Angular/Vue.js."
      />
      <div class="grid gap-5 md:grid-cols-2">
        {projects.slice(0, 4).map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <SectionTitle
        eyebrow="Blog"
        title="Notes d'architecture et de production"
        description="Articles pratiques pour équipes backend Java travaillant avec Kafka, Kubernetes et Datadog."
      />
      <div class="grid gap-5 md:grid-cols-3">
        {
          blogPosts.map((post) => (
            <article class="card rounded-lg p-6">
              <h3 class="text-xl font-bold text-ink">
                <a class="hover:text-brand-700" href={post.href}>{post.title}</a>
              </h3>
              <p class="mt-3 leading-7 text-slate-600">{post.description}</p>
              <a class="mt-5 inline-flex font-semibold text-brand-700 hover:underline" href={post.href}>Lire l'article</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page grid gap-8 md:grid-cols-[1fr_420px] md:items-center">
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-brand-600">Contact rapide</p>
        <h2 class="text-3xl font-bold text-ink md:text-4xl">Besoin d'un profil Java senior pour une plateforme critique ?</h2>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-600">
          Je peux intervenir sur la conception de microservices, l'intégration Kafka, les batchs,
          les API REST, les interfaces Angular/Vue.js, l'observabilité Datadog et la mise en place de CI/CD.
        </p>
      </div>
      <ContactCard />
    </div>
  </section>
</BaseLayout>
