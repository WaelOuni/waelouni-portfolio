---
import ResumeDownloads from "./ResumeDownloads.astro";
import { language, localizePath } from "../i18n/utils";
const lang = language(Astro.url);
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-white">
  <div class="container-page flex flex-col gap-4 py-8 text-sm text-slate-600 md:flex-row md:items-center md:justify-between">
    <p>© {year} Wael Ouni. {lang === "en" ? "SEO-optimized static Astro portfolio." : "Portfolio statique Astro optimisé SEO."}</p>
    <div class="flex flex-wrap gap-4">
      <a class="hover:text-brand-700" href="mailto:waelounie@gmail.com">waelounie@gmail.com</a>
      <ResumeDownloads />
      <a class="hover:text-brand-700" href={localizePath("/contact/", lang)}>Contact</a>
    </div>
  </div>
</footer>
