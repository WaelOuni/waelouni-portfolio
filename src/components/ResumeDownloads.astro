---
import { resumes } from '../i18n/resumes';
import { language } from '../i18n/utils';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const lang = language(Astro.url);
const labels = lang === 'en' ? { en: 'Download English Resume', fr: 'Download French CV' } : { en: 'Télécharger le CV anglais', fr: 'Télécharger le CV français' };
---
{Object.values(resumes).some(Boolean) && <div class:list={['resume-controls', { 'resume-compact': compact }]}>
  {resumes[lang] && <a class="button" href={resumes[lang]} download>{lang === 'en' ? 'Download Resume' : 'Télécharger mon CV'}</a>}
  <details>
    <summary>{lang === 'en' ? 'Resume languages' : 'Langues du CV'}</summary>
    <ul class="resume-options">
      {([lang, lang === 'en' ? 'fr' : 'en'] as const).map(locale => resumes[locale] && <li><a href={resumes[locale]} download hreflang={locale}>{labels[locale]}</a></li>)}
    </ul>
  </details>
</div>}
