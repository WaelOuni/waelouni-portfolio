---
import { postsFor, readingMinutes } from '../lib/blog';
import { language, localizePath } from '../i18n/utils';
import { portfolioCopy } from '../i18n/portfolio';
interface Props { heading?: 'h2' | 'h3' }
const { heading: Heading = 'h3' } = Astro.props;
const lang = language(Astro.url);
const c = portfolioCopy(lang);
const posts = await postsFor(lang);
---
<div>
  {posts.map((post, i) => <article class="article-row">
    <span class="article-index text-sm text-slate-500" aria-hidden="true">0{i + 1}</span>
    <div><Heading><a href={localizePath(`/blog/${post.data.translationKey}/`, lang)}>{post.data.title}</a></Heading><p class="mt-2 max-w-3xl text-slate-600">{post.data.description}</p></div>
    <span class="whitespace-nowrap text-sm text-slate-600">{readingMinutes(post)} {c('reading')}</span>
  </article>)}
</div>
