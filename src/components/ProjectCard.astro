---
import type { Project } from '@data/projects';
import { language } from '../i18n/utils';
import { portfolioCopy } from '../i18n/portfolio';
import { routes } from '../i18n/routes';
interface Props { project: Project }
const { project } = Astro.props;
const lang = language(Astro.url);
const c = portfolioCopy(lang);
const content = project.content[lang];
---
<article id={project.id} class="case-study">
  <div><p class="eyebrow">{project.client}</p><h3 class="mt-4 text-2xl font-semibold">{content.title}</h3><p class="mt-5 text-sm leading-7 text-slate-600">{project.stack.join(' · ')}</p><a class="text-link mt-4 text-sm" href={`${routes.experience[lang]}#${project.experienceId}`}>{c('relatedExperience')} <span aria-hidden="true">↗</span></a></div>
  <dl class="space-y-6">{(['context','challenge','delivered'] as const).map(key => <div><dt class="detail-label">{c(key)}</dt><dd class="text-slate-600">{content[key]}</dd></div>)}</dl>
</article>
