---
import { translator, language } from "../i18n/utils";
const lang = language(Astro.url);
const t = translator(lang);

import type { Project } from "@data/projects";

export interface Props {
  heading?: "h2" | "h3";
  project: Project;
}

const { project, heading: Heading = "h3" } = Astro.props;
---

<article class="card flex h-full flex-col rounded-lg p-6">
  <Heading class="text-xl font-bold text-ink">{project.title}</Heading>
  <p class="mt-3 flex-1 leading-7 text-slate-600">{project.description}</p>
  <div class="mt-5">
    <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">{t("Stack")}</p>
    <div class="mt-2 flex flex-wrap gap-2">
      {project.stack.map((tech) => <span class="rounded-md bg-brand-50 px-3 py-1 text-sm font-medium text-brand-700">{tech}</span>)}
    </div>
  </div>
  <ul class="mt-5 grid gap-2 text-sm text-slate-700">
    {project.highlights.map((point) => <li class="flex gap-2"><span aria-hidden="true" class="mt-2 size-1.5 rounded-full bg-brand-500"></span><span>{point}</span></li>)}
  </ul>
</article>
