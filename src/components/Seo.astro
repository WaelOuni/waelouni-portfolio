---
import { portfolioCopy } from "../i18n/portfolio";
import { language, routeKey } from "../i18n/utils";
import { routes } from "../i18n/routes";
const lang = language(Astro.url);
const key = routeKey(Astro.url.pathname);
const localized = key ? routes[key] : undefined;
const site = Astro.site ?? new URL("https://waelouni.fr");

export interface Props {
  title: string;
  description: string;
  modifiedAt?: string;
  canonical?: string;
  type?: "website" | "article";
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, site).href,
  type = "website"
} = Astro.props;

const siteName = lang === "en" ? "Wael Ouni — Senior Java Engineer" : "Wael Ouni — Ingénieur Java Senior";
const fullTitle = title.includes("Wael Ouni") ? title : `${title} | Wael Ouni`;
const ogImage = new URL(`/og-image-${lang}.png`, Astro.site ?? Astro.url).href;
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Wael Ouni",
  jobTitle: portfolioCopy(lang)("role"),
  sameAs: ["https://github.com/WaelOuni", "https://www.linkedin.com/in/wael-ouni-fullstack-developer/"],
  email: "mailto:waelounie@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Lille",
    addressCountry: "FR"
  },
  knowsAbout: [
    "Java",
    "Spring Boot",
    "Apache Kafka",
    "PostgreSQL",
    "Angular",
    "Vue.js",
    "MongoDB",
    "Oracle",
    "Kubernetes",
    "Docker",
    "GCP",
    "Datadog",
    "Microservices",
    lang === "en" ? "Event-driven architecture" : "Architecture event-driven"
  ],
  url: Astro.site?.href ?? "https://waelouni.fr"
};
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: new URL(lang === "fr" ? "/fr/" : "/", site).href,
  inLanguage: lang === "en" ? "en-GB" : "fr-FR",
  publisher: {
    "@type": "Person",
    name: "Wael Ouni"
  }
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{localized && (["en", "fr", "x-default"] as const).map(locale => <link rel="alternate" hreflang={locale} href={new URL(localized[locale === "fr" ? "fr" : "en"], site).href} />)}
<meta property="og:locale" content={lang === "en" ? "en_GB" : "fr_FR"} />
<meta property="og:locale:alternate" content={lang === "en" ? "fr_FR" : "en_GB"} />
<meta name="robots" content="index, follow" />
<meta property="og:type" content={type} />
{type === "article" && Astro.props.modifiedAt && <meta property="article:modified_time" content={Astro.props.modifiedAt} />}
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={siteName} />
<meta name="twitter:image:alt" content={siteName} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

<script is:inline type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": type === "article" ? "TechArticle" : "WebPage", ...(type === "article" && Astro.props.modifiedAt ? {dateModified: Astro.props.modifiedAt} : {}), name: fullTitle, headline: fullTitle, description, url: canonical, inLanguage: lang, author: {"@type": "Person", name: "Wael Ouni"}})} />
