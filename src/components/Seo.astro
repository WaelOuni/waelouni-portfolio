---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: "website" | "article";
}

const {
  title,
  description,
  canonical = Astro.url.href,
  type = "website"
} = Astro.props;

const siteName = "Wael Ouni - Développeur Fullstack Java Senior";
const fullTitle = title.includes("Wael Ouni") ? title : `${title} | Wael Ouni`;
const ogImage = new URL("/og-image.svg", Astro.site ?? Astro.url).href;
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Wael Ouni",
  jobTitle: "Développeur Fullstack Java Senior",
  email: "mailto:waelounie@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Lille",
    addressCountry: "FR"
  },
  knowsAbout: [
    "Java",
    "Spring Boot",
    "Apache Kafka",
    "PostgreSQL",
    "Angular",
    "Vue.js",
    "MongoDB",
    "Oracle",
    "Kubernetes",
    "Docker",
    "GCP",
    "Datadog",
    "Microservices",
    "Architecture event-driven"
  ],
  url: Astro.site?.href ?? "https://waelouni.fr"
};
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: Astro.site?.href ?? "https://waelouni.fr",
  inLanguage: "fr-FR",
  publisher: {
    "@type": "Person",
    name: "Wael Ouni"
  }
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
