---
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mb-10 max-w-3xl">
  {eyebrow && <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-brand-600">{eyebrow}</p>}
  <h2 class="text-3xl font-bold tracking-normal text-ink md:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-lg leading-8 text-slate-600">{description}</p>}
</div>
