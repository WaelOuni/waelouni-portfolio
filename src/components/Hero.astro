---
import ResumeDownloads from './ResumeDownloads.astro';
import { language, translator } from '../i18n/utils';
import { portfolioCopy } from '../i18n/portfolio';
import { routes } from '../i18n/routes';
const lang = language(Astro.url);
const c = portfolioCopy(lang);
const t = translator(lang);
---
<section class="border-b border-line bg-white">
  <div class="container-page hero-layout">
    <div>
      <p class="eyebrow">Wael Ouni <span aria-hidden="true">/</span> {lang === 'en' ? 'Freelance engineer' : 'Ingénieur freelance'}</p>
      <h1 class="display-title mt-6">{c('role')}</h1>
      <p class="mt-6 text-xl font-medium leading-relaxed text-slate-800">{c('promise')}</p>
      <p class="lead mt-4">{c('intro')}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="button button-primary" href={routes.contact[lang]}>{c('workTogether')} <span class="ml-3" aria-hidden="true">↗</span></a>
        <a class="button" href={routes.experience[lang]}>{c('exploreExperience')}</a>
      </div>
      <div class="mt-3"><ResumeDownloads compact /></div>
    </div>
    <figure class="hero-photo">
      <picture>
        <source srcset="/photo-wael-ouni.webp" type="image/webp" />
        <img src="/photo-wael-ouni.png" alt={t('Portrait professionnel de Wael Ouni')} width="720" height="720" decoding="async" fetchpriority="high" />
      </picture>
      <figcaption><strong class="block text-ink">Wael Ouni</strong>{c('location')}<span class="mt-2 block text-xs">Java · Spring Boot · Apache Kafka</span></figcaption>
    </figure>
  </div>
</section>
