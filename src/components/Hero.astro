---
---

<section class="border-b border-line bg-[radial-gradient(circle_at_top_left,#dbeafe_0,transparent_30%),linear-gradient(180deg,#ffffff_0%,#f8fafc_100%)]">
  <div class="container-page grid gap-8 py-16 md:grid-cols-[1.35fr_0.65fr] md:items-center md:py-24">
    <div>
      <p class="mb-4 inline-flex rounded-md border border-brand-100 bg-white px-3 py-1 text-sm font-semibold text-brand-700">
        Java • Spring Boot • Kafka • GCP • Kubernetes • Angular
      </p>
      <h1 class="max-w-4xl text-5xl font-bold tracking-normal text-ink md:text-6xl">
        Wael Ouni
      </h1>
      <p class="mt-4 text-2xl font-semibold text-slate-800">Développeur Fullstack Java Senior</p>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
        J’aide les équipes produit et plateforme à construire des systèmes distribués robustes,
        scalables et observables avec Java, Spring Boot, Kafka, GCP, Kubernetes et Angular.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="inline-flex items-center justify-center rounded-md bg-brand-500 px-5 py-3 font-semibold text-white shadow-soft transition hover:bg-brand-600" href="/parcours/">
          Voir mon parcours
        </a>
        <a class="inline-flex items-center justify-center rounded-md border border-line bg-white px-5 py-3 font-semibold text-ink transition hover:border-brand-500 hover:text-brand-700" href="/contact/">
          Me contacter
        </a>
        <a class="inline-flex items-center justify-center rounded-md border border-line bg-white px-5 py-3 font-semibold text-ink transition hover:border-brand-500 hover:text-brand-700" href="/cv-wael-ouni.pdf">
          Télécharger mon CV
        </a>
      </div>
    </div>
    <div class="card overflow-hidden rounded-lg p-0 md:ml-auto md:max-w-[340px]">
      <div class="bg-slate-100 p-3">
        <div class="mx-auto aspect-[4/5] w-full max-w-[240px] overflow-hidden rounded-lg border border-line bg-white shadow-soft sm:max-w-[260px]">
          <picture>
            <source srcset="/photo-wael-ouni.webp" type="image/webp" />
            <img
              src="/photo-wael-ouni.png"
              alt="Portrait professionnel de Wael Ouni"
              width="720"
              height="720"
              class="size-full object-cover object-[54%_50%]"
              decoding="async"
              fetchpriority="high"
            />
          </picture>
        </div>
      </div>
      <div class="p-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Profil senior</p>
      <h2 class="mt-3 text-2xl font-bold text-ink">Fullstack Java pour systèmes distribués à fort volume</h2>
      <dl class="mt-6 grid gap-4">
        <div class="rounded-lg bg-slate-50 p-4">
          <dt class="font-semibold text-ink">Domaines</dt>
          <dd class="mt-1 text-slate-600">Supply Chain, assurance, e-commerce, paiement, reporting</dd>
        </div>
        <div class="rounded-lg bg-slate-50 p-4">
          <dt class="font-semibold text-ink">Impact</dt>
          <dd class="mt-1 text-slate-600">Microservices, Kafka, CI/CD, observabilité et support production</dd>
        </div>
        <div class="rounded-lg bg-slate-50 p-4">
          <dt class="font-semibold text-ink">Localisation</dt>
          <dd class="mt-1 text-slate-600">Lille, France • Remote / hybride</dd>
        </div>
      </dl>
      </div>
    </div>
  </div>
</section>
