---
import type { Experience } from '@data/experiences';
import { portfolioCopy } from '../i18n/portfolio';
import { language } from '../i18n/utils';
interface Props { experience: Experience }
const { experience } = Astro.props;
const c = portfolioCopy(language(Astro.url));
---
<article id={experience.id} class="case-study">
  <div><p class="eyebrow">{experience.period}</p><h2 class="mt-4 text-2xl font-semibold">{experience.client}</h2><p class="mt-3 font-medium text-slate-600">{experience.role}</p></div>
  <div>
    <h3 class="detail-label">{c('context')}</h3><p class="text-slate-600">{experience.context}</p>
    <h3 class="detail-label mt-6">{c('contributions')}</h3>
    <ul class="list-disc space-y-2 pl-5 text-slate-700">{experience.achievements.map(achievement => <li>{achievement}</li>)}</ul>
    <p class="mt-6 border-t border-line pt-4 text-sm leading-7 text-slate-600"><span class="font-semibold text-ink">{c('technology')} · </span>{experience.stack.join(' · ')}</p>
  </div>
</article>
