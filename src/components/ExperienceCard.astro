---
import type { Experience } from "@data/experiences";

export interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
---

<article class="relative border-l-2 border-brand-100 pl-6">
  <span class="absolute -left-[9px] top-1 size-4 rounded-full border-4 border-white bg-brand-500 shadow"></span>
  <div class="card rounded-lg p-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
      <div>
        <h2 class="text-2xl font-bold text-ink">{experience.role}</h2>
        {experience.client && <p class="mt-1 font-semibold text-brand-700">Client : {experience.client}</p>}
      </div>
      <p class="rounded-md bg-brand-50 px-3 py-1 text-sm font-semibold text-brand-700">{experience.period}</p>
    </div>
    <p class="mt-4 leading-7 text-slate-600">{experience.context}</p>
    <ul class="mt-5 grid gap-2 text-slate-700">
      {experience.achievements.map((achievement) => <li class="flex gap-2"><span aria-hidden="true" class="mt-2 size-1.5 rounded-full bg-brand-500"></span><span>{achievement}</span></li>)}
    </ul>
    <div class="mt-6 flex flex-wrap gap-2">
      {experience.stack.map((tech) => <span class="rounded-md bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700">{tech}</span>)}
    </div>
  </div>
</article>
