---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { language, translator } from '../i18n/utils';
import { portfolioCopy } from '../i18n/portfolio';
import { routes } from '../i18n/routes';
const lang = language(Astro.url);
const t = translator(lang);
const c = portfolioCopy(lang);
const links = (['home', 'experience', 'skills', 'projects', 'blog', 'contact'] as const).map((key, index) => ({ href: routes[key][lang], label: t(['Accueil', 'Parcours', 'Compétences', 'Projets', 'Blog', 'Contact'][index]) }));
const active = (href: string) => Astro.url.pathname === href || (href === routes.blog[lang] && Astro.url.pathname.startsWith(href));
---
<header class="site-header">
  <nav class="container-page header-row" aria-label={c('navigation')}>
    <a href={routes.home[lang]} class="brand">
      <span class="brand-mark">WO</span><span class="brand-name">Wael Ouni</span><span class="sr-only"> — {t('Accueil')}</span>
    </a>
    <div class="nav-links">
      {links.map(link => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
    </div>
    <div class="header-tools">
      <LanguageSwitcher />
      <details class="mobile-menu">
        <summary>{c('menu')}</summary>
        <div class="mobile-links">
          {links.map(link => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
        </div>
      </details>
    </div>
  </nav>
</header>
