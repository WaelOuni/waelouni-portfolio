---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { language, translator } from '../i18n/utils';
import { routes } from '../i18n/routes';
const lang = language(Astro.url);
const t = translator(lang);
const links = (['home', 'experience', 'skills', 'projects', 'blog', 'contact'] as const).map((key, index) => ({href: routes[key][lang], label: t(['Accueil', 'Parcours', 'Compétences', 'Projets', 'Blog', 'Contact'][index])}));

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line bg-white/90 backdrop-blur">
  <nav class="container-page flex min-h-16 items-center justify-between flex-wrap gap-2 py-2" aria-label={t("Navigation principale")}>
    <a href={routes.home[lang]} class="flex items-center gap-3 font-semibold text-ink" aria-label={`WO Wael Ouni — ${t("Accueil")}`}>
      <span class="grid size-9 place-items-center rounded-lg bg-brand-500 text-sm font-bold text-white">WO</span>
      <span class="hidden sm:inline">Wael Ouni</span>
    </a>
    <div class="order-3 w-full flex items-center gap-1 overflow-x-auto sm:order-none sm:w-auto py-3 text-sm font-medium text-slate-600">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "whitespace-nowrap rounded-md px-3 py-2 transition hover:bg-brand-50 hover:text-brand-700",
              currentPath === link.href && "bg-brand-50 text-brand-700"
            ]}
            aria-current={currentPath === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <LanguageSwitcher />
  </nav>
</header>
