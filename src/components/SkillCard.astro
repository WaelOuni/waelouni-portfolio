---
import type { SkillCategory } from '@data/skills';
import { language } from '../i18n/utils';
import { portfolioCopy } from '../i18n/portfolio';
import { routes } from '../i18n/routes';
interface Props { skill: SkillCategory; evidence: string }
const { skill, evidence } = Astro.props;
const lang = language(Astro.url);
const c = portfolioCopy(lang);
---
<article class="border-t border-line py-8">
  <h2 class="text-2xl font-semibold">{skill.title}</h2>
  <p class="mt-4 text-slate-600">{skill.description}</p>
  <ul class="mt-5 grid grid-cols-2 gap-x-5 gap-y-2 text-sm font-medium text-slate-700">{skill.items.map(item => <li>{item}</li>)}</ul>
  <a class="text-link mt-5 text-sm" href={`${routes.experience[lang]}#${evidence}`}>{c('evidence')}<span class="sr-only"> — {skill.title}</span><span aria-hidden="true">↗</span></a>
</article>
