---
import { translator, language } from "../i18n/utils";
const lang = language(Astro.url);
const t = translator(lang);

import type { SkillCategory } from "@data/skills";

export interface Props {
  heading?: "h2" | "h3";
  skill: SkillCategory;
}

const { skill, heading: Heading = "h3" } = Astro.props;
---

<article class="card h-full rounded-lg p-6">
  <Heading class="text-xl font-bold text-ink">{skill.title}</Heading>
  <p class="mt-3 leading-7 text-slate-600">{skill.description}</p>
  <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${t("Compétences")} ${skill.title}`}>
    {skill.items.map((item) => <li class="rounded-md bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700">{item}</li>)}
  </ul>
</article>
