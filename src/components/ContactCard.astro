---
import { language } from '../i18n/utils';
import { portfolioCopy } from '../i18n/portfolio';
const lang = language(Astro.url);
const c = portfolioCopy(lang);
---
<aside class="contact-panel">
  <h2 class="text-2xl font-semibold">{c('directContact')}</h2>
  <a class="text-link mt-5 text-lg" href="mailto:waelounie@gmail.com">waelounie@gmail.com</a>
  <p class="mt-3 text-slate-600">{c('location')} · Freelance</p>
  <div class="mt-7 grid gap-2 border-t border-line pt-5">
    <a class="text-link" href="https://www.linkedin.com/in/wael-ouni-fullstack-developer/">{c('linkedin')} <span aria-hidden="true">↗</span></a>
    <a class="text-link" href="https://github.com/WaelOuni">{c('github')} <span aria-hidden="true">↗</span></a>
  </div>
  <a class="button button-primary mt-6 w-full" href={`mailto:waelounie@gmail.com?subject=${encodeURIComponent(lang === 'en' ? 'Freelance backend project' : 'Projet backend freelance')}`}>{c('getInTouch')}</a>
</aside>
